# Production template. Never commit real secrets.
# Generate strong random values with a secret manager, not by editing this file.
POSTGRES_USER=qaati
POSTGRES_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
POSTGRES_DB=qaati_db
JWT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
# Access token lifetime — short by design, since a leaked access token is
# usable until it expires (no server-side access-token revocation). A
# refresh-token flow (backend/src/auth/refresh-token.service.ts) now handles
# long-lived, revocable sessions: refresh tokens are hashed at rest, rotated
# on every use, and reuse of an already-rotated token revokes every session
# for that user. Set REFRESH_TOKEN_TTL_DAYS below to control how long a
# refresh token lasts if never used.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
ELASTIC_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
FRONTEND_URL=https://app.example.com
ADMIN_URL=https://admin.example.com

# Never expose OTP in API responses unless explicitly enabled for isolated local testing.
OTP_EXPOSE_IN_RESPONSE=false
